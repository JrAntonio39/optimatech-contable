# Copia este archivo como .env y ajusta si cambias puertos o claves
DATABASE_URL=postgresql://postgres:optimatech123@localhost:5434/optimatech_db
APP_ENV=development
# En producción configura JWT_SECRET con un valor aleatorio largo y privado.
JWT_SECRET=
JWT_EXPIRE_MIN=480
# Separa múltiples orígenes con comas si el frontend se sirve en otro host.
CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
